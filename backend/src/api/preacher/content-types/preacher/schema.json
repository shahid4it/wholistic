{
  "kind": "collectionType",
  "collectionName": "preachers",
  "info": {
    "singularName": "preacher",
    "pluralName": "preachers",
    "displayName": "Readers & Healers"
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {},
  "attributes": {
    "name": {
      "type": "string"
    },
    "bio": {
      "type": "text"
    },
    "profile": {
      "type": "media",
      "multiple": false,
      "allowedTypes": [
        "images",
        "files",
        "videos",
        "audios"
      ]
    },
    "tags": {
      "type": "string"
    },
    "tagList": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::tag.tag",
      "inversedBy": "preachers"
    },
    "tools": {
      "type": "string",
      "visible": false
    },
    "oneliner": {
      "type": "string"
    },
    "details": {
      "type": "component",
      "repeatable": true,
      "component": "preachers.detail"
    },
    "topics": {
      "type": "string",
      "visible": false
    },
    "abilities": {
      "type": "string",
      "visible": false
    },
    "style": {
      "type": "string",
      "visible": false
    },
    "slug": {
      "type": "uid",
      "targetField": "name",
      "required": true
    },
    "services": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::service.service",
      "inversedBy": "preachers"
    },
    "rating": {
      "type": "decimal",
      "default": 4.3
    },
    "specialty": {
      "type": "enumeration",
      "enum": [
        "reader",
        "healer"
      ]
    },
    "testimonials": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::testimonial.testimonial",
      "mappedBy": "reader"
    },
    "totalReadings": {
      "type": "integer"
    },
    "email": {
      "type": "email",
      "private": true
    },
    "timeSlots": {
      "type": "component",
      "repeatable": true,
      "component": "preachers.time-slot"
    }
  }
}
