# Strapi backend
NEXT_PUBLIC_STRAPI_URL=http://localhost:1337
STRAPI_GRAPHQL_URL=http://localhost:1337/graphql
# The frontend's own public origin — server-side fetches go through it, and
# next.config.mjs rewrites /graphql from here to STRAPI_GRAPHQL_URL.
NEXT_PUBLIC_LANDING_URL=http://localhost:3000

# Scoped Strapi API tokens (create these in Strapi Admin > Settings > API Tokens)
STRAPI_SUBSCRIBE_TOKEN=
STRAPI_BOOKING_TOKEN=
STRAPI_CONTACT_TOKEN=

# Session cookie signing (must match across restarts, or existing sessions break)
JWT_SECRET=
# Set to "true" only once the site is served over HTTPS — a Secure cookie is
# never sent over plain HTTP, so logins would silently fail if set too early.
COOKIE_SECURE=false

# reCAPTCHA (currently disabled in code until these are set — see BUG-03 in QA-REPORT.md)
CAPTCHA_SECRET_KEY=
NEXT_PUBLIC_CAPTCHA_SITE_KEY=
